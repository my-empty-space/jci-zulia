---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Button from '../../components/Button.astro';
import IconClock from '../../assets/icons/clock.svg';
import IconSessions from '../../assets/icons/sessions.svg';
import IconCalendar from '../../assets/icons/calendar.svg';
import coursesData from '../../data/courses.json';

export async function getStaticPaths() {
  return coursesData.map((course) => ({
    params: { slug: course.slug },
    props: { course },
  }));
}

const { course } = Astro.props;
---

<Layout title={`${course.title} - Academia JCI Zulia`}>
  <Navbar />

  <main class="course-detail-page">
    <!-- Breadcrumb & Header Hero -->
    <header class="course-hero">
      <img
        src={course.image}
        alt=""
        class="hero-bg-blur"
        aria-hidden="true"
        loading="eager"
      />
      <div class="hero-overlay-gradient"></div>

      <div class="container hero-container-rel">
        <!-- Breadcrumbs -->
        <nav class="breadcrumbs" aria-label="Navegación secundaria">
          <a href="/">Inicio</a>
          <span class="separator">/</span>
          <a href="/academy">Academia</a>
          <span class="separator">/</span>
          <span class="current">{course.title}</span>
        </nav>

        <div class="hero-grid">
          <div class="hero-text">
            <span class="hero-badge">PROGRAMA CERTIFICADO DE FORMACIÓN</span>
            <h1 class="hero-title">{course.title}</h1>
            <p class="hero-description">{course.description}</p>

            <!-- Key Specs Pills -->
            <div class="hero-pills">
              <div class="pill">
                <IconClock class="pill-icon" />
                <span>{course.duration}</span>
              </div>
              <div class="pill">
                <IconSessions class="pill-icon" />
                <span>{course.sessions}</span>
              </div>
              <div class="pill">
                <IconCalendar class="pill-icon" />
                <span>Fecha: <strong>{course.date}</strong></span>
              </div>
            </div>

            <!-- CTA Row -->
            <div class="hero-actions">
              <Button href={course.enrollUrl} variant="solid" size="lg">
                Inscribirme en este curso
              </Button>
              <Button href="/academy" variant="outline-white" size="lg">
                Ver todos los cursos
              </Button>
            </div>
          </div>
        </div>
      </div>
    </header>

    <!-- Detailed Content Body -->
    <section class="course-body-section">
      <div class="container body-container">
        <div class="main-content">
          <!-- Overview Card / Objectives -->
          <article class="content-block">
            <h2 class="block-title">Objetivos del Programa</h2>
            <p class="block-intro">
              Al finalizar esta formación, los participantes habrán desarrollado competencias clave para liderar proyectos y debates de alto nivel:
            </p>
            <ul class="objectives-list">
              {
                course.objectives.map((obj) => (
                  <li class="objective-item">
                    <span class="check-bullet" aria-hidden="true">✓</span>
                    <span>{obj}</span>
                  </li>
                ))
              }
            </ul>
          </article>

          <!-- Modules / Syllabus -->
          <article class="content-block">
            <h2 class="block-title">Temario y Estructura Modular</h2>
            <div class="modules-accordion">
              {
                course.modules.map((mod, index) => (
                  <div class="module-card">
                    <div class="module-header">
                      <span class="module-number">0{index + 1}</span>
                      <h3 class="module-title">{mod.title}</h3>
                    </div>
                    <p class="module-description">{mod.description}</p>
                  </div>
                ))
              }
            </div>
          </article>

          <!-- Target Audience -->
          <article class="content-block">
            <h2 class="block-title">¿A quién está dirigido?</h2>
            <div class="target-box">
              <p>{course.targetAudience}</p>
            </div>
          </article>
        </div>

        <!-- Sidebar Sticky Card -->
        <aside class="sidebar-col">
          <div class="sidebar-card">
            <div class="sidebar-image-box">
              <img
                src={course.image}
                alt={course.title}
                class="sidebar-image"
                loading="eager"
              />
            </div>
            <div class="sidebar-content">
              <div class="summary-item">
                <span class="summary-label">Modalidad:</span>
                <span class="summary-value">{course.modality}</span>
              </div>
              <div class="summary-item">
                <span class="summary-label">Nivel:</span>
                <span class="summary-value">{course.level}</span>
              </div>
              <div class="summary-item">
                <span class="summary-label">Instructor / Equipo:</span>
                <span class="summary-value">{course.instructor}</span>
              </div>
              <div class="summary-item">
                <span class="summary-label">Certificación:</span>
                <span class="summary-value highlight">Certificado Oficial JCI Zulia</span>
              </div>

              <div class="sidebar-action">
                <Button href={course.enrollUrl} variant="solid" size="md" class="w-full">
                  Inscribirse Ahora
                </Button>
              </div>
            </div>
          </div>
        </aside>
      </div>
    </section>

    <!-- Bottom CTA Banner -->
    <section class="bottom-cta-section">
      <div class="container">
        <div class="cta-banner">
          <div class="cta-info">
            <h2 class="cta-heading">¿Tienes dudas sobre la inscripción?</h2>
            <p class="cta-sub">
              Ponte en contacto con nuestro equipo académico para recibir asesoría personalizada.
            </p>
          </div>
          <Button href="/contact" variant="solid" size="lg">
            Contactar al Equipo
          </Button>
        </div>
      </div>
    </section>
  </main>
</Layout>

<style>
  .course-detail-page {
    background-color: var(--color-gray-50);
    min-height: 80vh;
  }

  /* Hero Section */
  .course-hero {
    position: relative;
    overflow: hidden;
    padding: 4.5rem 0 5.5rem;
    background-color: var(--color-jci-black);
    color: var(--color-jci-white);
  }

  .hero-bg-blur {
    position: absolute;
    inset: -15px;
    width: calc(100% + 30px);
    height: calc(100% + 30px);
    object-fit: cover;
    object-position: center;
    filter: blur(6px) brightness(0.8);
    z-index: 1;
  }

  .hero-overlay-gradient {
    position: absolute;
    inset: 0;
    opacity: 0.8;
    background: linear-gradient(
      135deg,
      var(--color-jci-black) 0%,
      #08539e50 100%
    );
    z-index: 2;
  }

  .hero-container-rel {
    position: relative;
    z-index: 3;
  }

  .breadcrumbs {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-main);
    font-size: 0.875rem;
    color: rgba(255, 255, 255, 0.7);
    margin-bottom: 2rem;
  }

  .breadcrumbs a {
    color: rgba(255, 255, 255, 0.85);
    transition: color var(--transition-fast);
  }

  .breadcrumbs a:hover {
    color: var(--color-jci-blue);
  }

  .breadcrumbs .current {
    color: var(--color-jci-teal);
    font-weight: 600;
  }

  .hero-badge {
    display: inline-block;
    font-family: var(--font-main);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--color-jci-teal);
    margin-bottom: 0.75rem;
  }

  .hero-title {
    font-family: var(--font-main);
    font-size: clamp(2.2rem, 4vw, 3.25rem);
    font-weight: 800;
    line-height: 1.15;
    color: var(--color-jci-white);
  }

  .hero-description {
    margin-top: 1rem;
    font-family: var(--font-main);
    font-size: clamp(1rem, 1.5vw, 1.15rem);
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.88);
    max-width: 720px;
  }

  .hero-pills {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
    margin-top: 2rem;
  }

  .pill {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    border-radius: 20px;
    font-family: var(--font-main);
    font-size: 0.9rem;
    color: var(--color-jci-white);
  }

  .pill-icon {
    width: 16px;
    height: 16px;
    color: var(--color-jci-blue);
  }

  .hero-actions {
    margin-top: 2.5rem;
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  /* Main Body Section */
  .course-body-section {
    padding: 4rem 0 6rem;
  }

  .body-container {
    display: grid;
    grid-template-columns: 1fr 360px;
    gap: 3rem;
    align-items: start;
  }

  .main-content {
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }

  .content-block {
    background-color: var(--color-jci-white);
    border-radius: 16px;
    padding: 2.5rem;
    border: 1px solid rgba(226, 232, 240, 0.8);
  }

  .block-title {
    font-family: var(--font-main);
    font-size: 1.5rem;
    font-weight: 800;
    color: var(--color-jci-black);
    margin-bottom: 1.25rem;

    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .block-title::before {
    content: '';
    display: inline-block;
    width: 4px;
    height: 1.2em;
    background-color: var(--color-jci-blue);
    border-radius: 2px;
  }

  .block-intro {
    font-family: var(--font-main);
    font-size: 1rem;
    line-height: 1.6;
    color: var(--color-gray-600);
    margin-bottom: 1.5rem;
  }

  .objectives-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .objective-item {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    font-family: var(--font-main);
    font-size: 1rem;
    line-height: 1.55;
    color: var(--color-gray-800);
  }

  .check-bullet {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 22px;
    height: 22px;
    background-color: rgba(0, 151, 215, 0.12);
    color: var(--color-jci-blue);
    border-radius: 50%;
    font-weight: 800;
    font-size: 0.85rem;
    flex-shrink: 0;
    margin-top: 2px;
  }

  /* Modules Accordion / List */
  .modules-accordion {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .module-card {
    border: 1px solid var(--color-gray-200);
    border-radius: 12px;
    padding: 1.5rem;
    background-color: var(--color-gray-50);
  }

  .module-header {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 0.5rem;
  }

  .module-number {
    font-family: var(--font-main);
    font-size: 0.9rem;
    font-weight: 800;
    color: var(--color-jci-blue);
    background-color: var(--color-jci-white);
    border: 1px solid rgba(0, 151, 215, 0.3);
    padding: 0.2rem 0.6rem;
    border-radius: 6px;
  }

  .module-title {
    font-family: var(--font-main);
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--color-jci-black);
  }

  .module-description {
    font-family: var(--font-main);
    font-size: 0.95rem;
    line-height: 1.55;
    color: var(--color-gray-600);
  }

  .target-box {
    background-color: rgba(87, 188, 188, 0.08);
    border-left: 4px solid var(--color-jci-teal);
    padding: 1.25rem 1.5rem;
    border-radius: 0 10px 10px 0;
    font-family: var(--font-main);
    font-size: 1rem;
    line-height: 1.6;
    color: var(--color-gray-800);
  }

  /* Sidebar Sticky Card */
  .sidebar-col {
    position: sticky;
    top: 6rem;
  }

  .sidebar-card {
    background-color: var(--color-jci-white);
    border-radius: 16px;
    overflow: hidden;
    border: 1px solid rgba(226, 232, 240, 0.8);
    box-shadow: 0 10px 30px rgba(19, 15, 45, 0.06);
  }

  .sidebar-image-box {
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
  }

  .sidebar-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .sidebar-content {
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .summary-item {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    font-family: var(--font-main);
    font-size: 0.9rem;

    padding-bottom: 0.85rem;
    border-bottom: 1px dashed var(--color-gray-200);
  }

  .summary-item:last-of-type {
    border-bottom: none;
    padding-bottom: 0;
  }

  .summary-label {
    color: var(--color-gray-600);
    font-weight: 500;
  }

  .summary-value {
    color: var(--color-jci-black);
    font-weight: 700;
  }

  .summary-value.highlight {
    color: var(--color-jci-blue);
  }

  .sidebar-action {
    margin-top: 0.5rem;
  }

  .sidebar-action :global(.w-full) {
    width: 100%;
  }

  /* Bottom Banner */
  .bottom-cta-section {
    padding-bottom: 6rem;
  }

  .cta-banner {
    background: linear-gradient(135deg, var(--color-jci-navy) 0%, var(--color-jci-black) 100%);
    border-radius: 16px;
    padding: 3rem 3.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    color: var(--color-jci-white);
  }

  .cta-heading {
    font-family: var(--font-main);
    font-size: 1.8rem;
    font-weight: 800;
    color: var(--color-jci-white);
  }

  .cta-sub {
    margin-top: 0.5rem;
    font-family: var(--font-main);
    font-size: 1rem;
    color: rgba(255, 255, 255, 0.85);
  }

  /* Responsive Breakdown */
  @media (max-width: 992px) {
    .body-container {
      grid-template-columns: 1fr;
    }

    .sidebar-col {
      position: static;
    }

    .cta-banner {
      flex-direction: column;
      align-items: flex-start;
      padding: 2.5rem;
    }
  }

  @media (max-width: 640px) {
    .content-block {
      padding: 1.5rem;
    }

    .hero-actions {
      flex-direction: column;
      align-items: stretch;
    }

    .hero-actions :global(.btn) {
      width: 100%;
    }
  }
</style>
