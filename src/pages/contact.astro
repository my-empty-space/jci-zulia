---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
---

<Layout title="Contacto - JCI Zulia">
  <Navbar />
  <main class="container page-content">
    <h1>Contacto y Membresía</h1>
    <p>¿Quieres ser parte de la JCI Zulia o colaborar con nosotros? Escríbenos.</p>
  </main>
</Layout>

<style>
  .page-content {
    padding-top: 4rem;
    padding-bottom: 4rem;
  }
  h1 {
    font-size: 2.5rem;
    color: var(--color-jci-black);
    margin-bottom: 1rem;
  }
  p {
    font-size: 1.15rem;
    color: var(--color-gray-600);
  }
</style>
