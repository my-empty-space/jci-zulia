---
interface Props {
  variant?: 'solid' | 'outline' | 'ghost' | 'outline-white';
  size?: 'sm' | 'md' | 'lg';
  href?: string;
  type?: 'button' | 'submit' | 'reset';
  class?: string;
  [key: string]: any;
}

const {
  variant = 'solid',
  size = 'md',
  href,
  type = 'button',
  class: className = '',
  ...props
} = Astro.props;

const Tag = href ? 'a' : 'button';
const prefetchProps = href ? { 'data-astro-prefetch': 'hover' } : {};
---

<Tag
  href={href}
  type={!href ? type : undefined}
  class:list={['btn', `btn--${variant}`, `btn--${size}`, className]}
  {...prefetchProps}
  {...props}
>
  <slot />
</Tag>

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-main);
    font-weight: 600;
    border-radius: 4px;
    transition: all var(--transition-fast);
    text-decoration: none;
    cursor: pointer;
    white-space: nowrap;
    outline: none;
  }

  .btn:focus-visible {
    outline: 2px solid var(--color-jci-blue);
    outline-offset: 2px;
  }

  /* Sizes */
  .btn--sm {
    padding: 0.4rem 1rem;
    font-size: 0.875rem;
  }

  .btn--md {
    padding: 0.65rem 1.4rem;
    font-size: 0.95rem;
  }

  .btn--lg {
    padding: 0.85rem 1.8rem;
    font-size: 1.05rem;
  }

  /* Variants */
  .btn--solid {
    background-color: var(--color-jci-blue);
    color: var(--color-jci-white);
    box-shadow: 0 2px 6px rgba(0, 151, 215, 0.25);
  }

  .btn--solid:hover {
    background-color: var(--color-jci-blue-hover);
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(0, 151, 215, 0.35);
  }

  .btn--solid:active {
    transform: translateY(0);
    box-shadow: 0 2px 4px rgba(0, 151, 215, 0.2);
  }

  .btn--outline {
    background-color: transparent;
    border: 2px solid var(--color-jci-blue);
    color: var(--color-jci-blue);
  }

  .btn--outline:hover {
    background-color: var(--color-jci-blue);
    color: var(--color-jci-white);
  }

  .btn--ghost {
    background-color: transparent;
    color: var(--color-jci-black);
  }

  .btn--ghost:hover {
    background-color: rgba(0, 151, 215, 0.08);
    color: var(--color-jci-blue);
  }

  .btn--outline-white {
    background-color: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.35);
    color: var(--color-jci-white);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
  }

  .btn--outline-white:hover {
    background-color: rgba(255, 255, 255, 0.15);
    border-color: rgba(255, 255, 255, 0.7);
    color: var(--color-jci-white);
    transform: translateY(-1px);
  }
</style>
