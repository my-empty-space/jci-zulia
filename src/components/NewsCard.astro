---
interface Props {
  title: string;
  excerpt: string;
  image: string;
  slug: string;
  featured?: boolean;
  class?: string;
}

const {
  title,
  excerpt,
  image,
  slug,
  featured = false,
  class: className = '',
} = Astro.props;

const href = `/news/${slug}`;
---

<article class:list={['news-card', { 'news-card--featured': featured }, className]}>
  <a href={href} class="news-card-link" data-astro-prefetch="hover">
    {
      featured ? (
        /* Featured Layout (Image Background + Gradient Overlay + White Text) */
        <div class="featured-wrapper">
          <img
            src={image}
            alt={title}
            class="featured-image"
            loading="lazy"
            width="800"
            height="450"
          />
          <div class="featured-overlay" />
          <div class="featured-content">
            <h3 class="featured-title">{title}</h3>
            <p class="featured-excerpt">{excerpt}</p>
          </div>
        </div>
      ) : (
        /* Regular Layout (Top Image + Bottom Content + "Leer más →") */
        <div class="regular-wrapper">
          <div class="regular-image-box">
            <img
              src={image}
              alt={title}
              class="regular-image"
              loading="lazy"
              width="400"
              height="225"
            />
          </div>
          <div class="regular-content">
            <h3 class="regular-title">{title}</h3>
            <p class="regular-excerpt">{excerpt}</p>
            <span class="regular-action">
              Leer más
              <svg
                class="arrow-icon"
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <line x1="5" y1="12" x2="19" y2="12" />
                <polyline points="12 5 19 12 12 19" />
              </svg>
            </span>
          </div>
        </div>
      )
    }
  </a>
</article>

<style>
  .news-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    border-radius: 16px;
    overflow: hidden;
    transition: transform var(--transition-normal), box-shadow var(--transition-normal);
  }

  .news-card-link {
    display: block;
    height: 100%;
    text-decoration: none;
    color: inherit;
  }

  /* Featured Card Styles */
  .news-card--featured {
    grid-column: span 2;
  }

  .featured-wrapper {
    position: relative;
    width: 100%;
    height: 100%;
    min-height: 380px;
    border-radius: 16px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
  }

  .featured-image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 400ms ease-in-out;
  }

  .featured-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(19, 15, 45, 0.92) 0%,
      rgba(19, 15, 45, 0.6) 45%,
      rgba(19, 15, 45, 0.1) 100%
    );
    z-index: 1;
  }

  .featured-content {
    position: relative;
    z-index: 2;
    padding: 2.25rem;
    color: var(--color-jci-white);
  }

  .featured-title {
    font-family: var(--font-main);
    font-size: clamp(1.35rem, 2.2vw, 1.85rem);
    font-weight: 800;
    line-height: 1.25;
    letter-spacing: -0.015em;
    color: var(--color-jci-white);
  }

  .featured-excerpt {
    margin-top: 0.85rem;
    font-family: var(--font-main);
    font-size: clamp(0.95rem, 1.2vw, 1.05rem);
    line-height: 1.55;
    color: rgba(255, 255, 255, 0.88);
    max-width: 620px;
  }

  .news-card--featured:hover {
    transform: translateY(-3px);
    box-shadow: 0 16px 36px rgba(19, 15, 45, 0.2);
  }

  .news-card--featured:hover .featured-image {
    transform: scale(1.04);
  }

  /* Regular Card Styles */
  .regular-wrapper {
    display: flex;
    flex-direction: column;
    height: 100%;
    background-color: var(--color-jci-white);
    border-radius: 16px;
    padding: 1.25rem;
    border: 1px solid rgba(226, 232, 240, 0.8);
    transition: border-color var(--transition-normal);
  }

  .regular-image-box {
    width: 100%;
    aspect-ratio: 16 / 9;
    border-radius: 12px;
    overflow: hidden;
    flex-shrink: 0;
  }

  .regular-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 400ms ease-in-out;
  }

  .regular-content {
    display: flex;
    flex-direction: column;
    flex: 1;
    margin-top: 1.25rem;
  }

  .regular-title {
    font-family: var(--font-main);
    font-size: 1.15rem;
    font-weight: 700;
    line-height: 1.35;
    color: var(--color-gray-600);
  }

  .regular-excerpt {
    margin-top: 0.65rem;
    font-family: var(--font-main);
    font-size: 0.925rem;
    line-height: 1.55;
    color: var(--color-gray-600);
    flex: 1;
  }

  .regular-action {
    margin-top: 1.25rem;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-main);
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--color-jci-blue);
    transition: color var(--transition-fast);
  }

  .arrow-icon {
    transition: transform var(--transition-fast);
  }

  .news-card:not(.news-card--featured):hover {
    transform: translateY(-3px);
    box-shadow: 0 12px 28px rgba(19, 15, 45, 0.08);
  }

  .news-card:not(.news-card--featured):hover .regular-image {
    transform: scale(1.04);
  }

  .news-card:not(.news-card--featured):hover .regular-action {
    color: var(--color-jci-blue-hover);
  }

  .news-card:not(.news-card--featured):hover .arrow-icon {
    transform: translateX(4px);
  }

  /* Responsive Breakdown */
  @media (max-width: 900px) {
    .news-card--featured {
      grid-column: span 1;
    }

    .featured-wrapper {
      min-height: 320px;
    }
  }
</style>
