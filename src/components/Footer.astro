---
import NavLink from './NavLink.astro';

const currentYear = new Date().getFullYear();
const contactEmail = import.meta.env.PUBLIC_CONTACT_EMAIL || import.meta.env.CONTACT_EMAIL || 'presidencia@jcizulia.org';

const navLinks = [
  { label: 'Inicio', href: '/' },
  { label: 'Nosotros', href: '/about-us' },
  { label: 'Academia', href: '/academy' },
  { label: 'Noticias', href: '/news' },
  { label: 'Contacto', href: '/contact' },
];
---

<footer class="footer-root" role="contentinfo" aria-label="Pie de página de JCI Zulia">
  <div class="container">
    <!-- Top Main Grid -->
    <div class="footer-grid">
      <!-- Column 1: Brand & Instagram -->
      <div class="footer-col brand-col">
        <a href="/" class="footer-brand" aria-label="JCI Zulia - Inicio">
          <img
            src="/logo-inverted.svg"
            alt="JCI Zulia Logo"
            width="150"
            height="50"
            class="footer-logo"
            loading="lazy"
          />
        </a>
        <p class="brand-desc">
          Desarrollando líderes para un mundo cambiante. Organización de jóvenes
          ciudadanos activos dedicados a crear impacto positivo en la comunidad del Estado Zulia.
        </p>

        <!-- Social Media Icons (Instagram & WhatsApp) -->
        <div class="social-links">
          <a
            href="https://www.instagram.com/jcizuliaoficial/"
            target="_blank"
            rel="noopener noreferrer"
            class="social-icon-btn"
            aria-label="Sigue a JCI Zulia en Instagram @jcizuliaoficial"
          >
            <svg class="social-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
            </svg>
          </a>
          <a
            href="https://wa.me/584127734410"
            target="_blank"
            rel="noopener noreferrer"
            class="social-icon-btn"
            aria-label="Contactar a JCI Zulia por WhatsApp al +58 412-7734410"
          >
            <svg class="social-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-1.149 4.195 4.292-1.128zm10.702-5.592c-.299-.149-1.77-.874-2.046-.975-.276-.101-.477-.149-.678.149-.201.298-.778.975-.953 1.175-.175.199-.35.224-.649.075-.299-.149-1.264-.466-2.408-1.485-.89-.794-1.49-1.775-1.665-2.074-.175-.299-.019-.461.13-.61.134-.133.299-.349.449-.523.149-.175.199-.299.299-.499.1-.2.05-.374-.025-.523-.075-.149-.678-1.636-.929-2.239-.244-.587-.493-.507-.678-.516-.175-.008-.374-.01-.573-.01-.199 0-.523.075-.797.374-.274.299-1.047 1.023-1.047 2.496 0 1.473 1.072 2.896 1.222 3.096.149.199 2.11 3.222 5.111 4.516.714.309 1.272.493 1.706.63.715.227 1.366.195 1.88.118.574-.086 1.77-.723 2.019-1.422.249-.699.249-1.297.175-1.422-.074-.125-.274-.224-.573-.373z"/>
            </svg>
          </a>
        </div>
      </div>

      <!-- Column 2: Navigation -->
      <div class="footer-col nav-col">
        <h2 class="col-heading">Navegación</h2>
        <ul class="footer-nav-list">
          {
            navLinks.map((link) => (
              <li>
                <NavLink href={link.href} class="footer-link">
                  {link.label}
                </NavLink>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Column 3: Contact & Headquarters -->
      <div class="footer-col contact-col">
        <h2 class="col-heading">Contacto y Sede</h2>
        <ul class="contact-list">
          <li class="contact-item">
            <svg class="contact-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
              <circle cx="12" cy="10" r="3"></circle>
            </svg>
            <a
              href="https://maps.app.goo.gl/p3jt6RAksMRBzFb58"
              target="_blank"
              rel="noopener noreferrer"
              class="contact-mail"
            >
              Cámara de Comercio de Maracaibo, Zulia
            </a>
          </li>
          <li class="contact-item">
            <svg class="contact-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
              <polyline points="22,6 12,13 2,6"></polyline>
            </svg>
            <a href={`mailto:${contactEmail}`} class="contact-mail">
              {contactEmail}
            </a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Bottom Copyright -->
    <div class="footer-bottom">
      <div class="legal-group">
        <p class="copyright">
          © {currentYear} JCI Zulia. Todos los derechos reservados.
        </p>
        <div class="legal-links">
          <a href="/privacy" class="legal-link">Políticas de Privacidad</a>
          <span class="legal-dot">•</span>
          <a href="/contact" class="legal-link">Contacto</a>
        </div>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer-root {
    background-color: var(--color-jci-navy);
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    padding-top: 4.5rem;
    padding-bottom: 2.5rem;
    color: var(--color-jci-white);
    position: relative;
    overflow: hidden;
  }

  /* Top accent highlight bar */
  .footer-root::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 4px;
    background: linear-gradient(
      90deg,
      var(--color-jci-blue) 0%,
      var(--color-jci-teal) 100%
    );
  }

  /* Grid Layout - 3 balanced columns */
  .footer-grid {
    display: grid;
    grid-template-columns: 1.8fr 1fr 1.2fr;
    gap: 4rem;
    padding-bottom: 3.5rem;
  }

  /* Column Headings */
  .col-heading {
    font-family: var(--font-main);
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--color-jci-white);
    margin-bottom: 1.25rem;
    letter-spacing: -0.01em;
  }

  /* Brand Column */
  .brand-col {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .footer-brand {
    display: inline-block;
    margin-bottom: 1rem;
    transition: transform var(--transition-fast);
  }

  .footer-brand:hover {
    transform: scale(1.02);
  }

  .footer-logo {
    height: 44px;
    width: auto;
    object-fit: contain;
  }

  .brand-desc {
    font-family: var(--font-main);
    font-size: 0.925rem;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.8);
    margin-bottom: 1.5rem;
    max-width: 420px;
  }

  /* Social Media Icons Styling */
  .social-links {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .social-icon-btn {
    color: var(--color-jci-white);
    transition: color var(--transition-fast);
  }

  .social-icon {
    width: 20px;
    height: 20px;
  }

  /* Navigation Column */
  .footer-nav-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  /* Custom styling for links inside dark footer */
  .footer-nav-list :global(a) {
    color: rgba(255, 255, 255, 0.8) !important;
    transition: color var(--transition-fast) !important;
  }

  .footer-nav-list :global(a:hover) {
    color: var(--color-jci-blue) !important;
  }

  /* Contact Column */
  .contact-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .contact-item {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    font-family: var(--font-main);
    font-size: 0.925rem;
    color: rgba(255, 255, 255, 0.8);
    line-height: 1.45;
  }

  .contact-icon {
    width: 18px;
    height: 18px;
    stroke: var(--color-jci-blue);
    flex-shrink: 0;
    margin-top: 0.15rem;
  }

  .contact-mail {
    color: var(--color-jci-white);
    font-weight: 600;
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .contact-mail:hover {
    color: var(--color-jci-blue);
    text-decoration: underline;
  }

  /* Bottom Copyright Bar */
  .footer-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 2rem;
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    gap: 1.5rem;
  }

  .legal-group {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    flex-wrap: wrap;
  }

  .copyright {
    font-family: var(--font-main);
    font-size: 0.875rem;
    color: rgba(255, 255, 255, 0.7);
  }

  .legal-links {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .legal-link {
    font-family: var(--font-main);
    font-size: 0.875rem;
    color: rgba(255, 255, 255, 0.7);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .legal-link:hover {
    color: var(--color-jci-blue);
  }

  .legal-dot {
    color: rgba(255, 255, 255, 0.3);
    font-size: 0.8rem;
  }

  /* Responsive Breakdown */
  @media (max-width: 1024px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
      gap: 2.5rem;
    }
  }

  @media (max-width: 640px) {
    .footer-root {
      padding-top: 3.5rem;
    }

    .footer-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
      padding-bottom: 2.5rem;
    }

    .footer-bottom {
      flex-direction: column;
      align-items: flex-start;
      gap: 1rem;
    }

    .legal-group {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.5rem;
    }
  }
</style>
